DATABASE_URL=
# Stable deployment secret used to sign login tokens and encrypt website-managed AI keys.
# Generate a long random value and never rotate it without re-entering saved AI keys.
SECRET_KEY=
# Optional dedicated encryption secret. If blank, SECRET_KEY is used. Keep the chosen value stable.
AI_CONFIG_ENCRYPTION_KEY=
# One-time developer bootstrap. Use an existing administrator email to promote it,
# or also set a 12+ character password to create a new developer account.
BOOTSTRAP_DEVELOPER_EMAIL=
BOOTSTRAP_DEVELOPER_PASSWORD=
BOOTSTRAP_DEVELOPER_NAME=System Developer
# Comma-separated frontend origins, for example https://your-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:5173
# ============================================
# Email Configuration for Staff Account Notifications
# ============================================
# Follow these steps to enable email functionality:

# OPTION 1: Using Gmail (Recommended for Testing)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an App Password for "Mail" and "Windows Computer"
# 3. Copy the 16-character password and paste it below
# 4. Uncomment the lines below and add your email address

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=


# OPTION 2: Using Corporate Email Server (uncomment if needed)
# SMTP_SERVER=mail.yourcompany.com
# SMTP_PORT=587
# SENDER_EMAIL=noreply@yourcompany.com
# SENDER_PASSWORD=your_smtp_password

# Cloudflare R2
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Google API key
GOOGLE_API_KEY=
# Optional override for the Render fallback response model.
GOOGLE_GENERATION_MODEL=gemini-3.1-flash-lite
# Optional comma-separated restriction for custom provider hosts.
# AI_PROVIDER_HOST_ALLOWLIST=api.deepseek.com,generativelanguage.googleapis.com
